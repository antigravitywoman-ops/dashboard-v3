# =============================================
# SEO Dashboard V2 - Environment Variables
# =============================================
# Copy this file to .env and fill in the values
# Deploy frontend to Vercel with these vars
# =============================================

# -------------------
# VM API Configuration
# -------------------

# Your GCP VM external IP or domain (include port 3456 for API)
NEXT_PUBLIC_VM_API_URL=https://your-vm-ip:3456

# Shared secret - must match GCP VM .env
# Generate with: openssl rand -base64 32
NEXT_PUBLIC_VM_API_KEY=your-api-key-here

# -------------------
# NextAuth Configuration
# -------------------

# Your Vercel deployment URL (update after deploying)
# Example: https://seo-dashboard.vercel.app
NEXTAUTH_URL=https://seo-dashboard.vercel.app

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here