# Copy this to .env on the VM and fill in secrets

# VM API Configuration
PORT=3456
VM_API_KEY=seo-dashboard-api-key-2026
OPENCLAW_DIR=/home/dev/openclaw-seo

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seo_dashboard

# Auth Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
NEXTAUTH_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# NextAuth (must match nginx URL for session cookies)
NEXTAUTH_URL=https://34.44.215.245
